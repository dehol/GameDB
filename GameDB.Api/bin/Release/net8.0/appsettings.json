{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=gamedb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "super-secret-key-minimum-32-characters-long",
    "Issuer": "GameDB",
    "Audience": "GameDB",
    "ExpiresInDays": "7"
  },
  "Igdb": {
    "ClientId": "YOUR_TWITCH_CLIENT_ID",
    "ClientSecret": "YOUR_TWITCH_CLIENT_SECRET",
    "ApiBaseUrl": "https://api.igdb.com/v4",
    "AuthUrl": "https://id.twitch.tv/oauth2/token",
    "RequestTimeoutSeconds": 60,
    "TokenRefreshMinutes": 30
  },
  "Import": {
    "BatchSize": 100,
    "SteamBatchSize": 50,
    "MaxConcurrentApiCalls": 10,
    "MaxConcurrentProcessing": 20,
    "MaxConcurrentDbOperations": 30,
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 1.0,
    "JobTimeoutMinutes": 120,
    "EnableDetailedLogging": true,
    "IgdbPopularGamesLimit": 5000,
    "RawDataRetentionDays": 7
  },
  "Steam": {
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GameDB.Infrastructure.BackgroundServices": "Information"
    }
  },
  "AllowedHosts": "*"
}